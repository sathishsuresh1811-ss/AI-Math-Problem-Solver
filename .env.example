# =============================================================================
# AI Math Problem Explainer and Error Checker - Environment Variables
# =============================================================================

# Flask Application Secret Key
SECRET_KEY=capstone-math-checker-secret-key-2026

# Server Port
PORT=5050

# SQLite Database Location
DATABASE_PATH=data/math_checker.db

# Spreadsheet and Report Exports Directory
EXPORTS_PATH=exports

# Numerical Equivalence Matching Tolerance (Default: 0.005)
NUMERIC_TOLERANCE=0.005

# -----------------------------------------------------------------------------
# Optional Live AI Provider API Keys
# (The application functions fully in baseline demo mode without paid keys)
# -----------------------------------------------------------------------------

# OpenAI (ChatGPT)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
